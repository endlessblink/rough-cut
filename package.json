{
  "name": "rough-cut-mvp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --sort build",
    "test": "pnpm build && pnpm -r --sort test",
    "typecheck": "pnpm -r --sort typecheck",
    "smoke:mvp": "pnpm --filter @rough-cut/project-model build && node scripts/smoke-mvp.mjs",
    "smoke:ui": "pnpm --filter @rough-cut/project-model build && pnpm --filter @rough-cut/desktop build && node scripts/smoke-ui.mjs",
    "dev": "pnpm --filter @rough-cut/desktop dev",
    "clean": "pnpm -r --parallel clean"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
